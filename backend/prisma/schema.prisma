generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum TripStatus {
  GENERATING
  READY
  FAILED
}

enum EventType {
  ACCOMMODATION
  DINING
  TRANSPORT
  ACTIVITY
  TIP
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  phoneNumber      String?          @map("phone_number")
  stripeCustomerId String?          @map("stripe_customer_id")
  subscriptionTier SubscriptionTier @default(FREE) @map("subscription_tier")
  createdAt        DateTime         @default(now()) @map("created_at")
  trips            Trip[]

  @@map("users")
}

model Trip {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id])
  destinations Json
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime         @map("end_date") @db.Date
  preferences Json?
  status      TripStatus       @default(GENERATING)
  createdAt   DateTime         @default(now()) @map("created_at")
  events      ItineraryEvent[]

  @@index([userId])
  @@map("trips")
}

model ItineraryEvent {
  id             String    @id @default(uuid())
  tripId         String    @map("trip_id")
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  eventType      EventType @map("event_type")
  title          String
  description    String?
  locationName   String?   @map("location_name")
  locationLat    Float?    @map("location_lat")
  locationLng    Float?    @map("location_lng")
  locationValidated Boolean? @map("location_validated")
  startTime      DateTime? @map("start_time")
  endTime        DateTime? @map("end_time")
  notifyWhatsapp Boolean   @default(false) @map("notify_whatsapp")
  estimatedPriceLabel String? @map("estimated_price_label")
  bookingUrl     String?   @map("booking_url")
  tripAdvisorRating      Float?  @map("trip_advisor_rating")
  tripAdvisorReviewCount Int?    @map("trip_advisor_review_count")
  tripAdvisorPriceLevel  String? @map("trip_advisor_price_level")
  tripAdvisorUrl         String? @map("trip_advisor_url")
  notes                  String? @map("notes")
  alternatives           Json?   @map("alternatives")
  whatsappNotifiedAt     DateTime? @map("whatsapp_notified_at")

  @@index([tripId])
  @@map("itinerary_events")
}
